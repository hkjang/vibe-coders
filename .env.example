# Copy to .env, set restrictive permissions, and replace every blank secret.
# Generate ADMIN_TOKEN and GATEWAY_SECRET once (for example with
# `openssl rand -hex 32`) and reuse the same values across container upgrades.
GATEWAY_VERSION=v0.83.1
UI_APP_ENABLED=false
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=
ADMIN_TOKEN=
GATEWAY_SECRET=
MODEL_PRICING_KRW_PER_1M={}
