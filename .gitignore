.env
.env.*
!.env.example
# Anchored to the repository root: an unanchored "data/" also matched source
# directories such as web/src/features/data, silently dropping them from commits.
/data/
/release/
*.db
*.sqlite
*.sqlite3
*.tar
*.tar.gz
/gateway.exe
/coverage.out
.playwright-mcp/
.gocache/
.pnpm-store/
/.gitframe
/output/
/seed.sql

# React application build and test output
/node_modules/
web/node_modules/
web/.pnpm-store/
web/.vite/
web/.eslintcache
web/dist/
web/coverage/
web/test-results/
web/playwright-report/

# The Go package keeps only a marker so clean Go builds can embed an empty dist.
# Production assets are always staged from web/dist by the Docker build.
internal/appui/dist/*
!internal/appui/dist/.gitkeep

# Temp test scripts and log files
*.log
/scratch/
