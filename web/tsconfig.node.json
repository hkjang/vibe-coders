{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.auth.config.ts",
    "playwright.provider-connection.config.ts",
    "tests/auth-live",
    "tests/provider-connection-live",
    "tests/e2e/code-editor.spec.ts",
    "tests/e2e/code-editor-app.spec.ts",
    "tests/e2e/code-editor-workflow.spec.ts",
    "tests/e2e/code-editor-golden-steps.spec.ts",
    "tests/e2e/code-editor-skill.spec.ts",
    "tests/e2e/skill-workspace.spec.ts",
    "tests/e2e/code-editor-library.spec.ts",
    "tests/e2e/code-editor-lab.spec.ts",
    "tests/e2e/code-editor-chat.spec.ts",
    "tests/e2e/code-editor-compare.spec.ts",
    "tests/e2e/mcp-contract-review.spec.ts",
    "tests/e2e/mcp-call-review.spec.ts",
    "tests/e2e/workflow-pagination.spec.ts",
    "tests/e2e/work-app-pagination.spec.ts",
    "tests/e2e/account-resource-search.spec.ts",
    "tests/fixtures/agent-code-editor.ts",
    "eslint.config.js"
  ]
}
